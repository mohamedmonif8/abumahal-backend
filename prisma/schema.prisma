generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  phone    String   @unique
  password String
  role     String   @default("عميل")
  branch   String?
}

model Branch {
  id   Int    @id @default(autoincrement())
  name String
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  isAvailable Boolean  @default(true)
}

model Order {
  id            Int      @id @default(autoincrement())
  userId        Int
  customerName  String
  orderType     String
  branch        String
  totalPrice    Float
  items         String   
  paymentStatus String
  status        String   @default("قيد الانتظار")
}
